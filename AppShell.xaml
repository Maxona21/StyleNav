<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StyleNav.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:StyleNav"
    Title="StyleNav">
    <TabBar>

        <ShellContent
            Title="Główna"
            Icon="home.png"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Szukaj"
            Icon="search.png"
            ContentTemplate="{DataTemplate local:Search}"
            Route="Search" />
        <ShellContent
            Title="Profile"
            Icon="search.png"
            ContentTemplate="{DataTemplate local:Profile}"
            Route="Profile" />
        
        <Tab Title="główna">
            <ShellContent
                Title="Aktualności"
                ContentTemplate="{DataTemplate local:NewsPage}"
                Route="NewsPage" />
            <ShellContent
                Title="Polecane"
                ContentTemplate="{DataTemplate local:FeaturedPage}"
                Route="FeaturedPaged"/>
        </Tab>
        <Tab Title="Profile">
            <ShellContent
                ContentTemplate="{DataTemplate local:Profile}"
                Route="Profile" />
        </Tab>

    </TabBar>
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
